{
  "version": 4,
  "id": "studio-probe",
  "name": "Studio probe",
  "capabilities": ["skill-source", "grader", "skill-lint", "skill-template", "studio-panel", "skill-router", "cli"],
  "state": "state",
  "hosts": [
    "probe.invalid",
    "example.com",
    "ten.studio-probe.test",
    "cgnat.studio-probe.test"
  ],
  "contributes": {
    "runs": "bin/studio-probe",
    "skill-source": { "title": "Probe skills" },
    "grader": { "title": "Probe grader" },
    "skill-lint": { "title": "Probe lint" },
    "skill-template": [
      { "id": "probe", "title": "Probe", "about": "A skill the probe writes, with its name and description." }
    ],
    "studio-panel": [
      { "id": "probe", "title": "Probe" }
    ],
    "skill-router": { "title": "Probe router" },
    "cli": [
      { "name": "try", "title": "Try one thing from inside the sandbox, and say what happened", "writes": false }
    ]
  }
}
