              "query",
              "# The account's own fork of a repository, under whatever name it has (#4342).\nquery ForkOfMine($owner: String!, $name: String!) {\n  repository(owner: $owner, name: $name) {\n    forks(first: 1, affiliations: [OWNER], ownerAffiliations: [OWNER]) {\n      nodes {\n        databaseId\n        nameWithOwner\n        url\n        visibility\n        owner {\n          __typename\n          login\n        }\n      }\n    }\n  }\n}\n"
