              "# What purlis reads before it merges a save's pull request itself: the merge methods the repo allows, and the pull request's state, head, mergeability and review decision.\nquery MergeReady($owner: String!, $name: String!, $number: Int!) {\n  repository(owner: $owner, name: $name) {\n    rebaseMergeAllowed\n    mergeCommitAllowed\n    squashMergeAllowed\n    pullRequest(number: $number) {\n      state\n      isDraft\n      headRefOid\n      mergeStateStatus\n      reviewDecision\n    }\n  }\n}\n"
            ]
          },
          {
            "text": [
              "owner",
              "acme"
            ]
          },
          {
            "text": [
              "name",
              "api"
            ]
          },
