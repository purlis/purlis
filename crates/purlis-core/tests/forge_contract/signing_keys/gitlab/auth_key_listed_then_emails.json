{
  "source": "GitLab REST API: users/:id/keys (public, and holds keys for signing in as well as signing) then user and user/emails (the account's confirmed addresses). What Check would read if it put GitLab's unknown_key down to the commit email (#5916); it reads none of it. The key is the test's own, put in for @KEY@.",
  "exchanges": [
    {
      "call": {
        "endpoint": {
          "rest": {
            "method": null,
            "path": "users/sam/keys"
          }
        },
        "fields": [
          {
            "typed": [
              "per_page",
              "100"
            ]
          }
        ]
      },
      "reply": {
        "code": 0,
        "out": "[{\"id\": 77, \"title\": \"purlis \u00b7 studio\", \"key\": \"@KEY@\", \"usage_type\": \"auth\"}]",
        "err": "",
        "status": 200
      }
    },
    {
      "call": {
        "endpoint": {
          "rest": {
            "method": null,
            "path": "user"
          }
        },
        "fields": []
      },
      "reply": {
        "code": 0,
        "out": "{\"id\": 42, \"username\": \"sam\", \"email\": \"sam@example.org\", \"confirmed_at\": \"2024-01-01T09:00:00.000Z\"}",
        "err": "",
        "status": 200
      }
    },
    {
      "call": {
        "endpoint": {
          "rest": {
            "method": null,
            "path": "user/emails"
          }
        },
        "fields": []
      },
      "reply": {
        "code": 0,
        "out": "[{\"id\": 1, \"email\": \"sam@billing.example.org\", \"confirmed_at\": \"2025-02-01T09:00:00.000Z\"}, {\"id\": 2, \"email\": \"unconfirmed@example.org\", \"confirmed_at\": null}]",
        "err": "",
        "status": 200
      }
    }
  ]
}
