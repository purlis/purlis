{
  "source": "GitLab REST API v4, docs.gitlab.com/api/user_keys (read 2026-11-08): Add an SSH key for the authenticated user (POST /user/keys, 201 Created) with usage_type signing, since the default is auth_and_signing; then List all SSH keys (GET /user/keys, 200), each with its usage_type. The key is the test's own, put in for @KEY@.",
  "exchanges": [
    {
      "call": {"endpoint": {"rest": {"method": "POST", "path": "user/keys"}}, "fields": [{"text": ["title", "purlis · studio"]}, {"text": ["key", "@KEY@"]}, {"text": ["usage_type", "signing"]}]},
      "reply": {"code": 0, "out": "{\"id\": 77, \"title\": \"purlis · studio\", \"key\": \"@KEY@\", \"created_at\": \"2026-11-08T09:00:00.000Z\", \"expires_at\": null, \"usage_type\": \"signing\"}", "err": "", "status": 201}
    },
    {
      "call": {"endpoint": {"rest": {"method": null, "path": "user/keys"}}, "fields": [{"typed": ["per_page", "100"]}]},
      "reply": {"code": 0, "out": "[{\"id\": 12, \"title\": \"purlis · laptop\", \"key\": \"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOtherDeviceKeyOtherDeviceKeyOtherDev\", \"usage_type\": \"signing\"}, {\"id\": 77, \"title\": \"purlis · studio\", \"key\": \"@KEY@\", \"usage_type\": \"signing\"}, {\"id\": 5, \"title\": \"my login key\", \"key\": \"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILoginOnlyLoginOnlyLoginOnlyLoginOn\", \"usage_type\": \"auth\"}]", "err": "", "status": 200}
    }
  ]
