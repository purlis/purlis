{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purlis/purlis/main/docs/schema/theme.schema.json",
  "title": "A purlis theme folder's theme.json (format 2)",
  "description": "A theme: a name, optionally the theme it extends, a palette of named colours, its icon set, its appearances, each tagged dark or light and optionally high contrast, what compact draws, and its fonts. purlis refuses a theme that breaks this grammar and draws Purlis in its place.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "anyOf": [
    {
      "required": [
        "appearances"
      ]
    },
    {
      "required": [
        "extends"
      ]
    }
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "description": "What to call the theme, as a person would.",
      "type": "string",
      "minLength": 1
    },
    "extends": {
      "description": "The id of the theme this one starts from: purlis-classic, or a theme folder's name. This theme holds only what differs.",
      "type": "string",
      "minLength": 1
    },
    "palette": {
      "description": "Named colours, hex only. A token names one by its name; the names are this theme's own.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/hex"
      },
      "maxProperties": 256
    },
    "appearances": {
      "description": "The theme's appearances, the first what it draws when nothing chose another. One with an id its parent has layers over that one.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/appearance"
      },
      "maxItems": 64
    },
    "icons": {
      "description": "The theme's icon set: the path of a JSON file inside this theme's folder, such as icons/icons.json, that draws each view's tab on the rails. A view it does not draw is the parent's.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "compact": {
      "description": "What compact draws, for every appearance, when the person chose compact density: geometry tokens and their numbers. A token not named is Purlis Classic's compact where that moves it, else the appearance's own.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "space.0": {
          "description": "Pixels at the default text size. Purlis Classic's is 0.",
          "type": "integer",
          "minimum": 0,
          "maximum": 0
        },
        "space.1": {
          "description": "Pixels at the default text size. Purlis Classic's is 2.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "space.2": {
          "description": "Pixels at the default text size. Purlis Classic's is 4.",
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "space.3": {
          "description": "Pixels at the default text size. Purlis Classic's is 6.",
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        },
        "space.4": {
          "description": "Pixels at the default text size. Purlis Classic's is 8.",
          "type": "integer",
          "minimum": 4,
          "maximum": 12
        },
        "space.5": {
          "description": "Pixels at the default text size. Purlis Classic's is 12.",
          "type": "integer",
          "minimum": 6,
          "maximum": 16
        },
        "space.6": {
          "description": "Pixels at the default text size. Purlis Classic's is 16.",
          "type": "integer",
          "minimum": 8,
          "maximum": 24
        },
        "space.7": {
          "description": "Pixels at the default text size. Purlis Classic's is 24.",
          "type": "integer",
          "minimum": 12,
          "maximum": 32
        },
        "space.8": {
          "description": "Pixels at the default text size. Purlis Classic's is 32.",
          "type": "integer",
          "minimum": 16,
          "maximum": 48
        },
        "font-size.2xs": {
          "description": "Pixels at the default text size. Purlis Classic's is 10.",
          "type": "integer",
          "minimum": 8,
          "maximum": 12
        },
        "font-size.xs": {
          "description": "Pixels at the default text size. Purlis Classic's is 11.",
          "type": "integer",
          "minimum": 9,
          "maximum": 13
        },
        "font-size.sm": {
          "description": "Pixels at the default text size. Purlis Classic's is 12.",
          "type": "integer",
          "minimum": 10,
          "maximum": 14
        },
        "font-size.md": {
          "description": "Pixels at the default text size. Purlis Classic's is 13.",
          "type": "integer",
          "minimum": 11,
          "maximum": 15
        },
        "font-size.base": {
          "description": "Pixels at the default text size. Purlis Classic's is 14.",
          "type": "integer",
          "minimum": 12,
          "maximum": 18
        },
        "font-size.lg": {
          "description": "Pixels at the default text size. Purlis Classic's is 16.",
          "type": "integer",
          "minimum": 13,
          "maximum": 22
        },
        "font-size.xl": {
          "description": "Pixels at the default text size. Purlis Classic's is 20.",
          "type": "integer",
          "minimum": 16,
          "maximum": 28
        },
        "font-weight.regular": {
          "description": "A font weight. Purlis Classic's is 400.",
          "type": "integer",
          "minimum": 300,
          "maximum": 500
        },
        "font-weight.medium": {
          "description": "A font weight. Purlis Classic's is 500.",
          "type": "integer",
          "minimum": 400,
          "maximum": 600
        },
        "font-weight.strong": {
          "description": "A font weight. Purlis Classic's is 600.",
          "type": "integer",
          "minimum": 500,
          "maximum": 800
        },
        "line-height.tight": {
          "description": "A share of the text's own size. Purlis Classic's is 1.2.",
          "type": "number",
          "minimum": 1,
          "maximum": 1.4
        },
        "line-height.body": {
          "description": "A share of the text's own size. Purlis Classic's is 1.4.",
          "type": "number",
          "minimum": 1.2,
          "maximum": 1.8
        },
        "radius.sm": {
          "description": "Pixels. Purlis Classic's is 3.",
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "radius.md": {
          "description": "Pixels. Purlis Classic's is 4.",
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "radius.lg": {
          "description": "Pixels. Purlis Classic's is 6.",
          "type": "integer",
          "minimum": 0,
          "maximum": 14
        },
        "radius.xl": {
          "description": "Pixels. Purlis Classic's is 8.",
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "radius.full": {
          "description": "Pixels. Purlis Classic's is 9999.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "size.control": {
          "description": "Pixels at the default text size. Purlis Classic's is 28.",
          "type": "integer",
          "minimum": 20,
          "maximum": 40
        },
        "size.chrome": {
          "description": "Pixels at the default text size. Purlis Classic's is 21.",
          "type": "integer",
          "minimum": 16,
          "maximum": 32
        },
        "focus-ring.width": {
          "description": "Pixels. Purlis Classic's is 2.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "focus-ring.offset": {
          "description": "Pixels. Purlis Classic's is 2.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "focus-ring.inset": {
          "description": "Pixels. Purlis Classic's is -2.",
          "type": "integer",
          "minimum": -4,
          "maximum": 0
        },
        "elevation.raised-y": {
          "description": "Pixels at the default text size. Purlis Classic's is 2.",
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "elevation.raised-blur": {
          "description": "Pixels at the default text size. Purlis Classic's is 8.",
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "elevation.overlay-y": {
          "description": "Pixels at the default text size. Purlis Classic's is 8.",
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "elevation.overlay-blur": {
          "description": "Pixels at the default text size. Purlis Classic's is 24.",
          "type": "integer",
          "minimum": 0,
          "maximum": 48
        }
      }
    },
    "fonts": {
      "description": "The UI, mono and terminal fonts, each from woff2 files in this folder's fonts/. A font not named is the parent's, or the platform's.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ui": {
          "$ref": "#/$defs/font"
        },
        "mono": {
          "$ref": "#/$defs/font"
        },
        "terminal": {
          "$ref": "#/$defs/font"
        }
      }
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "colour": {
      "description": "A hex colour, or the name of a colour in this theme's palette.",
      "anyOf": [
        {
          "$ref": "#/$defs/hex"
        },
        {
          "$ref": "#/$defs/name"
        }
      ]
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "appearance": {
          "description": "Whether it is drawn on a dark window or a light one. Required unless the theme it extends has an appearance of this id.",
          "enum": [
            "dark",
            "light"
          ]
        },
        "high-contrast": {
          "type": "boolean"
        },
        "tokens": {
          "$ref": "#/$defs/tokens"
        },
        "motion": {
          "$ref": "#/$defs/motion"
        }
      }
    },
    "tokens": {
      "description": "Token values: a colour for a colour token, a number in its bound for a geometry token. A token not named is the parent's, or Purlis Classic's of the same appearance.",
