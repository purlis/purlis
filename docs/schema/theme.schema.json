{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purlis/purlis/main/docs/schema/theme.schema.json",
  "title": "A purlis theme folder's theme.json (format 2)",
  "description": "A theme: a name, optionally the theme it extends, a palette of named colours, its icon set, and its appearances, each tagged dark or light and optionally high contrast. purlis refuses a theme that breaks this grammar and draws Purlis in its place.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "anyOf": [
    {
      "required": [
        "appearances"
      ]
    },
    {
      "required": [
        "extends"
      ]
    }
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "description": "What to call the theme, as a person would.",
      "type": "string",
      "minLength": 1
    },
    "extends": {
      "description": "The id of the theme this one starts from: purlis-classic, or a theme folder's name. This theme holds only what differs.",
      "type": "string",
      "minLength": 1
    },
    "palette": {
      "description": "Named colours, hex only. A token names one by its name; the names are this theme's own.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/hex"
      },
      "maxProperties": 256
    },
    "appearances": {
      "description": "The theme's appearances, the first what it draws when nothing chose another. One with an id its parent has layers over that one.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/appearance"
      },
      "maxItems": 64
    },
    "icons": {
      "description": "The theme's icon set: the path of a JSON file inside this theme's folder, such as icons/icons.json, that draws each view's tab on the rails. A view it does not draw is the parent's.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "colour": {
      "description": "A hex colour, or the name of a colour in this theme's palette.",
      "anyOf": [
        {
          "$ref": "#/$defs/hex"
        },
        {
          "$ref": "#/$defs/name"
        }
      ]
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "appearance": {
          "description": "Whether it is drawn on a dark window or a light one. Required unless the theme it extends has an appearance of this id.",
          "enum": [
            "dark",
            "light"
          ]
        },
        "high-contrast": {
          "type": "boolean"
        },
        "tokens": {
          "$ref": "#/$defs/tokens"
        },
        "motion": {
          "$ref": "#/$defs/motion"
        }
      }
    },
    "tokens": {
      "description": "Token values: a colour, or for a flag, the terminal cursor's shape or its line height, a value of that type. A token not named is the parent's, or Purlis Classic's of the same appearance.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface.base": {
          "$ref": "#/$defs/colour"
        },
        "surface.sunken": {
          "$ref": "#/$defs/colour"
        },
        "surface.deep": {
          "$ref": "#/$defs/colour"
        },
        "surface.raised": {
          "$ref": "#/$defs/colour"
        },
        "surface.overlay": {
          "$ref": "#/$defs/colour"
        },
        "surface.hover": {
          "$ref": "#/$defs/colour"
        },
        "control.base": {
          "$ref": "#/$defs/colour"
        },
        "control.hover": {
          "$ref": "#/$defs/colour"
        },
        "control.aimed": {
          "$ref": "#/$defs/colour"
        },
        "control.count": {
          "$ref": "#/$defs/colour"
        },
        "text.primary": {
          "$ref": "#/$defs/colour"
        },
        "text.secondary": {
          "$ref": "#/$defs/colour"
        },
        "text.muted": {
          "$ref": "#/$defs/colour"
        },
        "border.subtle": {
          "$ref": "#/$defs/colour"
        },
        "border.strong": {
          "$ref": "#/$defs/colour"
        },
        "accent.base": {
          "$ref": "#/$defs/colour"
        },
        "accent.surface": {
          "$ref": "#/$defs/colour"
        },
        "focus.ring": {
