    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "faces"
      ],
      "properties": {
        "family": {
          "description": "What the font is called, as Settings says it.",
          "type": "string",
          "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N} ._-]{0,63}$"
        },
        "faces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/face"
          },
          "minItems": 1,
          "maxItems": 8
        }
      }
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "description": "A woff2 file in this folder's fonts/: never a URL or a path out of the folder.",
          "type": "string",
          "pattern": "^fonts/[A-Za-z0-9_-][A-Za-z0-9._-]*\\.woff2$",
          "maxLength": 106
        },
        "weight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900
        },
        "style": {
          "enum": [
            "normal",
            "italic"
          ]
        }
      }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "layer": {
      "description": "Token values drawn over every appearance (tokens), and over one appearance by its id (appearances), after the first.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "$ref": "#/$defs/tokens"
        },
        "appearances": {
          "$ref": "#/$defs/per-appearance"
        }
      }
    },
    "per-appearance": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tokens": {
            "$ref": "#/$defs/tokens"
          }
        }
      }
    },
    "option": {
      "oneOf": [
        {
          "description": "A toggle: on or off. Its on layer is drawn when it is on.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "label",
            "default",
            "on"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/name"
            },
            "kind": {
              "const": "toggle"
            },
            "label": {
              "$ref": "#/$defs/label"
            },
            "description": {
              "type": "string",
              "maxLength": 280
            },
            "default": {
              "type": "boolean"
            },
            "on": {
              "$ref": "#/$defs/layer"
            }
          }
        },
        {
          "description": "A choice: one of its named values, each a layer.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "label",
            "default",
            "values"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/name"
            },
            "kind": {
              "const": "choice"
            },
            "label": {
              "$ref": "#/$defs/label"
            },
            "description": {
              "type": "string",
              "maxLength": 280
            },
            "default": {
              "description": "The id of the value drawn when nothing chose one.",
              "$ref": "#/$defs/name"
            },
            "values": {
              "type": "array",
              "minItems": 2,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/name"
                  },
                  "label": {
                    "$ref": "#/$defs/label"
                  },
                  "tokens": {
                    "$ref": "#/$defs/tokens"
                  },
                  "appearances": {
                    "$ref": "#/$defs/per-appearance"
                  }
                }
              }
            }
          }
        }
      ]
    }
