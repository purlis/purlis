          "type": "boolean",
          "description": "Whether ended dispatches are listed too."
        },
        "chats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Its id; chat-<n> for an open chat given none yet, <record id>.chat-<n> for an ended one: what a parent names it by."
              },
              "name": {
                "type": "string",
                "description": "Its name, as its tab shows it."
              },
              "persona": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The persona it runs as, or null."
