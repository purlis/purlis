                  "relation": {
                    "type": "string",
                    "enum": [
                      "dispatched",
                      "handed-off-from"
                    ],
                    "description": "dispatched: a task that owes it a report; handed-off-from: the work moved here."
                  }
                },
                "required": [
                  "id",
                  "relation"
                ],
                "additionalProperties": false
