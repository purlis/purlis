                "type": "string",
                "enum": [
                  "needs",
                  "stuck",
                  "failed",
                  "working",
                  "waiting",
                  "idle",
                  "ended",
                  "cant-tell"
                ],
                "description": "Its Chat state, as the window's mark keys it."
