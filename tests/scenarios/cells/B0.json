        },
        {
          "issue": 6657,
          "leg": "fake",
          "check": "refusal_black_hole",
          "refusal": "step 1",
          "note": "fake leg (CI run 44962030981): curl's refusal of the kept-blocked $h3 wrote no ask, block or hold"
