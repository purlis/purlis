{
  "$schema": "../schema/cells.schema.json",
  "batch": "B0",
  "title": "probe: network asks on the held path",
  "persona": "steward",
  "protection": "full",
  "hosts": {
    "h1": "example.com",
    "h2": "www.iana.org",
    "h3": "example.net",
    "h6": "example.org"
  },
  "cells": [
    {
      "id": "M-PRB-01",
      "dialects": [
        "claude"
      ],
      "steps": [
        {
          "calls": [
            {
              "tool": "Bash",
              "client": "get",
              "timeout": "150s",
              "input": {
                "command": "python3 \"$TMPDIR/purlis-matrix-<chat>/get.py\" https://$h1 110"
              }
            }
          ],
          "outcome": "failed",
          "refusal_expected": true,
          "window": [
            {
              "query": "blocks.marker_blocked == 1"
            },
            {
              "query": "ask.listed_for $h1",
              "forbid": true
            }
          ],
          "transcript": [
            {
              "says": "Tunnel connection failed"
            }
          ],
          "require": [
            {
              "kind": "ask.raised",
              "ask": "sandbox",
              "count": 1,
              "before": "post"
            },
            {
              "kind": "stop.block",
              "source": "sandbox",
              "target.host": "$h1",
              "qualifier": null,
              "count": 1
            },
            {
              "kind": "ask.raised",
              "ask": "sandbox",
              "within": "group+1"
            }
          ],
          "forbid": [
            {
              "kind": "ask.answered"
            }
          ]
        }
      ],
      "expected_fail": [
        {
          "issue": 6673,
          "leg": "fake",
          "step": 1,
          "assertion": "require[1]",
          "observed": 0,
          "note": "fake leg (CI run 44962030981): the block for $h1 is not in this step's window: the next step's window holds a stop.block"
        },
        {
          "issue": 6672,
          "leg": "fake",
          "step": 1,
          "assertion": "require[2]",
          "observed": {
            "from": "hold",
            "to": "hold+10"
          },
          "note": "fake leg (CI run 44962030981): the ask was written 31.2 s after the call's pre line, not within group+1 (hold is 30 s scaled)"
        },
        {
          "issue": 6673,
          "leg": "fake",
          "step": 1,
          "assertion": "window[0]",
          "observed": 0,
          "note": "fake leg (CI run 44962030981): the Chat log counted 0 blocks when the step ended: the block is written after it"
        },
        {
          "issue": 6673,
          "leg": "fake",
          "step": 1,
          "assertion": "window[1]",
          "observed": true,
          "note": "fake leg (CI run 44962030981): the ask for $h1 was still listed when the step ended: its row stays until the block is written"
        },
        {
          "issue": 7353,
          "leg": "fake",
          "step": 1,
          "assertion": "require[0]",
          "observed": "no hook.posttooluse",
          "note": "fake leg (CI run 44962030981): the window holds the call's pre line and no post line; the post line is written in a later window"
        },
        {
          "issue": 6674,
          "leg": "live",
          "step": 1,
          "assertion": "require[0]",
          "observed": 2,
          "note": "chat 682 (test-matrix-phase-1.md §8): every held ask wrote ask.raised twice"
        },
        {
          "issue": 6673,
          "leg": "live",
          "step": 1,
          "assertion": "require[1]",
          "observed": 0,
          "note": "chat 682 (§8): the block was written only at the next prompt, so it landed in step 2 (M-PRB-02)"
        },
        {
          "issue": 6672,
          "leg": "live",
          "step": 1,
          "assertion": "require[2]",
          "observed": {
            "from": "35s",
            "to": "50s"
          },
          "note": "chat 682 (§8): the ask came 45 s after the call started, not at about 2 s"
        }
      ]
    },
    {
      "id": "M-PRB-02",
      "dialects": [
        "claude"
      ],
      "steps": [
        {
          "calls": [
            {
              "tool": "Bash",
              "client": "get",
              "timeout": "150s",
              "input": {
                "command": "python3 \"$TMPDIR/purlis-matrix-<chat>/get.py\" https://$h2 110"
              }
            }
          ],
          "press": {
            "label": "Allow only for this chat",
            "target": "ask",
            "when": "ask.raised"
          },
          "outcome": "came_back",
          "window": [
            {
              "query": "ask.listed_for $h2",
              "forbid": true
            }
          ],
          "transcript": [
            {
              "says": "Allowed"
            }
          ],
          "require": [
            {
              "kind": "ask.raised",
              "ask": "sandbox",
              "count": 1
            },
            {
              "kind": "trust.sandbox.grant",
              "level": "chat",
              "what": "host",
              "target": "$h2",
              "count": 1
            },
            {
              "kind": "ask.answered",
              "ask": "sandbox",
              "answer": "allowed",
              "count": 1
            }
          ],
          "forbid": [
            {
              "kind": "stop.block"
            }
          ]
        }
      ],
      "expected_fail": [
      {
        "issue": 7353,
        "leg": "fake",
        "step": 1,
        "assertion": "calls",
        "observed": "no hook.pretooluse",
        "note": "fake leg (CI run 44992641994): the step's call returned (status 200) but its window holds no pre line: ask.raised, stop.block, trust.sandbox.grant, ask.answered only; where the pre line was written was not read"
      },
        {
          "issue": 6673,
          "leg": "fake",
          "step": 1,
          "assertion": "forbid[0]",
          "observed": 1,
          "note": "fake leg (CI run 44962030981): step 1's block lands in this step's window"
        },
        {
          "issue": 7356,
          "leg": "fake",
          "step": 1,
          "assertion": "transcript[0]",
          "observed": false,
          "note": "fake leg (CI run 44962030981): the chat's lines for this step are the prompt and the tool result; no later step's lines carry an Allowed sentence"
        },
        {
          "issue": 6674,
          "leg": "live",
          "step": 1,
          "assertion": "require[0]",
          "observed": 2,
          "note": "chat 682 (§8): every held ask wrote ask.raised twice"
        },
        {
          "issue": 6673,
          "leg": "live",
          "step": 1,
          "assertion": "forbid[0]",
          "observed": 1,
          "note": "chat 682 (§8): step 1's block, written at the next prompt, landed in this turn"
        }
      ]
    },
    {
