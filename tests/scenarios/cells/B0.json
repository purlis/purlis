{
  "$schema": "../schema/cells.schema.json",
  "batch": "B0",
  "title": "probe: network asks on the held path",
  "persona": "steward",
  "protection": "full",
  "hosts": {"h1": "example.com", "h2": "www.iana.org", "h3": "example.net", "h6": "example.org"},
  "cells": [
    {
      "id": "M-PRB-01",
      "dialects": ["claude"],
      "steps": [{
        "calls": [{"tool": "Bash", "client": "get", "timeout": "150s",
                   "input": {"command": "python3 \"$TMPDIR/purlis-matrix-<chat>/get.py\" https://$h1 110"}}],
        "outcome": "failed",
        "refusal_expected": true,
        "require": [
          {"kind": "ask.raised", "ask": "sandbox", "count": 1, "before": "post"},
          {"kind": "stop.block", "source": "sandbox", "target.host": "$h1", "qualifier": null, "count": 1},
          {"kind": "ask.raised", "ask": "sandbox", "within": "group+1"}
        ],
        "forbid": [{"kind": "ask.answered"}]
      }],
      "expected_fail": [
        {"issue": 6674, "step": 1, "assertion": "require[0]", "observed": 2,
         "note": "chat 682 (test-matrix-phase-1.md §8): every held ask wrote ask.raised twice"},
        {"issue": 6673, "step": 1, "assertion": "require[1]", "observed": 0,
         "note": "chat 682 (§8): the block was written only at the next prompt, so it landed in step 2 (M-PRB-02)"},
        {"issue": 6672, "step": 1, "assertion": "require[2]", "observed": {"from": "35s", "to": "50s"},
         "note": "chat 682 (§8): the ask came 45 s after the call started, not at about 2 s"}
      ]
    },
    {
      "id": "M-PRB-02",
      "dialects": ["claude"],
      "steps": [{
        "calls": [{"tool": "Bash", "client": "get", "timeout": "150s",
                   "input": {"command": "python3 \"$TMPDIR/purlis-matrix-<chat>/get.py\" https://$h2 110"}}],
        "press": {"label": "Allow only for this chat", "target": "ask", "when": "ask.raised"},
        "outcome": "came_back",
        "require": [
          {"kind": "ask.raised", "ask": "sandbox", "count": 1},
          {"kind": "trust.sandbox.grant", "level": "chat", "what": "host", "target": "$h2", "count": 1},
          {"kind": "ask.answered", "ask": "sandbox", "answer": "allowed", "count": 1}
        ],
        "forbid": [{"kind": "stop.block"}]
      }],
      "expected_fail": [
        {"issue": 6674, "step": 1, "assertion": "require[0]", "observed": 2,
         "note": "chat 682 (§8): every held ask wrote ask.raised twice"},
        {"issue": 6673, "step": 1, "assertion": "forbid[0]", "observed": 1,
         "note": "chat 682 (§8): step 1's block, written at the next prompt, landed in this turn"}
      ]
    },
    {
      "id": "M-PRB-03",
      "dialects": ["claude"],
      "steps": [{
        "calls": [{"tool": "Bash", "client": "get", "timeout": "150s",
                   "input": {"command": "python3 \"$TMPDIR/purlis-matrix-<chat>/get.py\" https://$h3 110"}}],
        "press": {"label": "Keep blocked", "target": "ask", "when": "ask.raised"},
        "outcome": "failed",
        "refusal_expected": true,
        "require": [
          {"kind": "ask.raised", "ask": "sandbox", "count": 1},
          {"kind": "stop.block", "source": "sandbox", "target.host": "$h3", "qualifier": null, "args": null, "count": 1},
          {"kind": "ask.answered", "ask": "sandbox", "answer": "refused", "count": 1}
        ],
        "forbid": [{"kind": "stop.block", "at": "next_prompt"}]
      }],
      "expected_fail": [
        {"issue": 6674, "step": 1, "assertion": "require[0]", "observed": 2,
         "note": "chat 682 (§8): every held ask wrote ask.raised twice; the rest of the cell passed"}
      ]
    },
    {
      "id": "M-PRB-04",
      "dialects": ["claude"],
      "steps": [{
        "calls": [{"tool": "Bash", "client": "curl", "timeout": "10s",
                   "input": {"command": "/usr/bin/curl -sS -m 10 https://$h3 -o /dev/null"}}],
        "outcome": "failed",
        "refusal_expected": true,
        "require": [
          {"kind": "stop.block", "source": "sandbox", "target.host": "$h3", "count": 1}
        ],
        "forbid": [{"kind": "ask.raised"}]
      }],
      "expected_fail": [
        {"issue": 6657, "step": 1, "assertion": "require[0]", "observed": 0,
         "note": "chat 682 (§8): the block was unverified, named no host, and came at the next prompt"},
        {"issue": 6657, "step": 1, "assertion": "forbid[0]", "observed": 1,
         "note": "chat 682 (§8): an unnamed-host ask was raised"}
      ]
    },
    {
      "id": "M-PRB-04b",
      "dialects": ["claude"],
      "steps": [{
        "calls": [{"tool": "Bash", "client": "curl", "timeout": "10s",
                   "input": {"command": "/usr/bin/curl -sS -m 10 https://$h3 -o /dev/null"}}],
        "outcome": "failed",
        "refusal_expected": true,
        "repeat_of": {"cell": "M-PRB-04", "step": 1},
        "require": [
          {"kind": "stop.block", "source": "sandbox", "target.host": "$h3", "count": 1}
        ]
      }],
      "expected_fail": [
        {"issue": 6657, "step": 1, "assertion": "require[0]", "observed": 0,
         "note": "chat 682 (§8): the repeat was throttled and silent"},
        {"issue": 6657, "check": "refusal_black_hole", "refusal": "step 1",
         "note": "chat 682 (§8): the throttled repeat refused with no ask, block or hold"}
      ]
    },
    {
      "id": "M-PRB-05",
      "dialects": ["claude"],
      "steps": [{
        "calls": [{"tool": "Bash", "client": "get", "timeout": "10s",
                   "input": {"command": "python3 \"$TMPDIR/purlis-matrix-<chat>/get.py\" https://$h3 10"}}],
        "outcome": "failed",
        "refusal_expected": true,
        "require": [{"kind": "stop.block", "source": "sandbox"}]
      }],
      "expected_fail": [
        {"issue": 6675, "step": 1, "assertion": "require[0]", "observed": 0,
         "note": "chat 682 (§8): black hole confirmed; urllib's refusal wrote nothing"},
        {"issue": 6675, "check": "refusal_black_hole", "refusal": "step 1",
         "note": "chat 682 (§8): the refusal came with no ask, block or hold"}
      ]
    },
    {
      "id": "M-PRB-06",
      "dialects": ["claude"],
      "steps": [{
        "calls": [
          {"tool": "Bash", "client": "get", "timeout": "3s",
           "input": {"command": "python3 \"$TMPDIR/purlis-matrix-<chat>/get.py\" https://$h6 3"}},
          {"tool": "Bash", "input": {"command": "echo moved-on"}}
        ],
        "require": [
          {"kind": "ask.raised", "ask": "sandbox", "count": 1, "before": "post"},
          {"kind": "stop.block", "source": "sandbox", "target.host": "$h6", "qualifier": null, "args": "this_call", "count": 1}
        ],
        "forbid": [{"kind": "stop.block", "at": "next_prompt"}]
      }],
      "expected_fail": [
        {"issue": 6672, "step": 1, "assertion": "require[0]", "observed": 0,
         "note": "chat 682 (§8): the client was gone at 3 s; the ask came 35 s later, once, after hook.stop"},
        {"issue": 6673, "step": 1, "assertion": "forbid[0]", "observed": 1,
         "note": "chat 682 (§8): the block was written 30 s after the ask, after hook.stop"}
      ]
    }
  ]
}
