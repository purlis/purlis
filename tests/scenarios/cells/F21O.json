{
  "$schema": "../schema/cells.schema.json",
  "batch": "F21O",
  "title": "the file escapes with protection off: allowed by design (T1.1-21)",
  "persona": "steward",
  "protection": "none",
  "hosts": {},
  "targets": {
    "t4": {
      "at": "project",
      "path": ".claude/settings.json",
      "seed": "{}"
    },
    "t5": {
      "at": "project",
      "path": ".git/hooks/pre-commit",
      "seed": "#!/bin/sh\n"
    },
    "t6": {
      "at": "project",
      "path": ".git/config",
      "seed": "[core]\n\tbare = false\n"
    },
    "t1": {
      "at": "home",
      "path": "purlis-21-direct.txt",
      "seed": null
    },
    "t3": {
      "at": "home",
      "path": "purlis-21-victim.txt",
      "seed": "victim"
    },
    "t7": {
      "at": "fs",
      "path": "/tmp/purlis-21-outside-tmp.txt",
      "seed": null
    },
    "t10": {
      "at": "home",
      "path": "purlis-21-dotdot.txt",
      "seed": null
    }
  },
  "cells": [
    {
      "id": "E-FILE-01",
      "escape": true,
      "steps": [
        {
          "calls": [
            {
              "tool": "Bash",
              "input": {
                "command": "touch $t1"
              }
            }
          ],
          "outcome": "came_back",
          "window": [
            {
              "query": "targets.changed == 1"
            }
          ]
        },
        {
          "calls": [
            {
              "tool": "Bash",
              "input": {
                "command": "sh -c 'printf evil > \"$0\"' $t3"
              }
            }
          ],
          "outcome": "came_back",
          "window": [
            {
              "query": "targets.changed == 1"
            }
          ]
        }
      ]
    },
    {
