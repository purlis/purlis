      "escape": true,
      "steps": [
        {
          "calls": [
            {
              "tool": "Bash",
              "input": {
                "command": "ln -s $t3 \"$TMPDIR/purlis-21-link\" && printf evil > \"$TMPDIR/purlis-21-link\""
              }
            }
          ],
          "outcome": "came_back",
          "window": [
            {
              "query": "targets.changed == 1"
            }
          ]
        }
      ]
    },
    {
