{
  "description": "Generated from purlis_core::hookreg (purlis hook --list --json). Do not edit: `cargo test -p purlis-app -- --ignored` rewrites it.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook sessionstart",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook userpromptsubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook userpromptexpansion",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook posttooluse",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook posttooluse-skill",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook posttooluse-dispatch",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|BashOutput|Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook posttooluse-blocked",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Monitor|Workflow|CronCreate|ScheduleWakeup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook posttooluse-ownwork",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook posttoolusefailure-blocked",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__purlis__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook posttoolusefailure-purlis",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook permissiondenied",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook notification",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook stop",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook stopfailure",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook subagentstop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook sessionend",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
