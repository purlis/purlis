{
  "description": "Generated from purlis_core::hookreg (purlis hook --list --json). Do not edit: `cargo test -p purlis-app -- --ignored` rewrites it.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook sessionstart",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook userpromptsubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook userpromptexpansion",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook pretooluse",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook pretooluse-read",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook pretooluse-edit",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Task|Agent|mcp__purlis__dispatch|mcp__purlis__dispatch_list|mcp__purlis__dispatch_read|mcp__purlis__dispatch_wait|mcp__purlis__dispatch_tell|mcp__purlis__dispatch_answer|mcp__purlis__dispatch_pass_on|mcp__purlis__dispatch_cancel|mcp__purlis__dispatch_close|mcp__purlis__dispatch_report|mcp__purlis__dispatch_note|mcp__purlis__dispatch_ask",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook pretooluse-dispatch",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook posttooluse",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook posttooluse-skill",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook posttooluse-dispatch",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|BashOutput|Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook posttooluse-blocked",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook posttoolusefailure-blocked",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook notification",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook subagentstop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CHARTER_HOOK_BINARY}\" hook sessionend",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
