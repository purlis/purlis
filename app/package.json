{
  "name": "purlis-app",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && tsc -p artifact-kit",
    "lint": "eslint .",
    "format": "prettier --config .prettierrc.json --write . ../crates/purlis-core/artifact-kit/purlis-page-mock.js",
    "format:check": "prettier --config .prettierrc.json --check . ../crates/purlis-core/artifact-kit/purlis-page-mock.js",
    "test": "vitest run --project unit",
    "test:stories": "vitest run --project \"stories *\"",
    "storybook": "storybook dev --port 6006 --no-open",
    "e2e": "wdio run e2e/wdio.conf.ts",
    "e2e:relaunch": "node ../tools/relaunch.mjs",
    "e2e:crash": "node ../tools/crash-relaunch.mjs",
    "build:e2e": "vite build --mode e2e",
    "e2e:state": "wdio run e2e/wdio.state.conf.ts",
    "e2e:finder": "wdio run e2e/wdio.finder.conf.ts",
    "e2e:layout": "wdio run e2e/wdio.layout.conf.ts",
    "e2e:picked": "wdio run e2e/wdio.picked.conf.ts",
    "e2e:rail": "wdio run e2e/wdio.rail.conf.ts",
    "e2e:browser": "wdio run e2e/wdio.browser.conf.ts",
    "e2e:upgrade": "wdio run e2e/wdio.upgrade.conf.ts",
    "e2e:outcome": "wdio run e2e/wdio.outcome.conf.ts",
    "e2e:pool": "wdio run e2e/wdio.pool.conf.ts",
    "e2e:scale": "wdio run e2e/wdio.scale.conf.ts"
  },
